# Ismerim WhatsApp Bot - configuração
PORT=3081
# Fuso do estabelecimento (padrão America/Sao_Paulo). Evita erro de data em servidor UTC.
TZ=America/Sao_Paulo

# ---- Banco de dados / arquivos de runtime ----
# Pasta onde ficam db.json, sessão do WhatsApp e logs.
# Vazio = ./data dentro do projeto. Para deixar o banco FORA do OneDrive:
#   DATA_DIR=C:/IsmerimBot/dados
DATA_DIR=
# (Somente Docker) pasta do host montada em /app/data pelo docker-compose.
#   DATA_HOST_DIR=C:/IsmerimBot/dados
DATA_HOST_DIR=

# ---- IA (agente) ----
# Provedor: deepseek | openai | codex | gemini
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
# (legado - usa como fallback se AI_API_KEY/AI_MODEL estiverem vazios)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Transcrição de áudio (STT) - o bot ouve notas de voz do WhatsApp ----
# Endpoint OpenAI-compatível (/audio/transcriptions). Ex.:
#   OpenAI:     URL=https://api.openai.com/v1/audio/transcriptions  MODEL=whisper-1
#   Groq:       URL=https://api.groq.com/openai/v1/audio/transcriptions  MODEL=whisper-large-v3
# Se TRANSCRIBE_API_KEY ficar vazio ou TRANSCRIBE_ENABLED=false, o bot avisa que não ouve áudios.
TRANSCRIBE_ENABLED=true
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1

# Número que receberá a notificação de novos agendamentos (ex: 5511999999999)
ADMIN_PHONE=
# Opcional: senha do painel local (http://localhost:3081). Se vazio, painel sem senha.
PANEL_TOKEN=
# Minutos que o agente fica pausado após um atendente responder pelo painel.
# Ao voltar a falar depois desse tempo, o agente retoma sozinho. 0 = nunca retoma.
HUMAN_PAUSE_MINUTES=30
# Antecedência do lembrete de agendamento enviado ao cliente (padrão 120 = 2h). 0 = desliga.
REMINDER_MINUTES_BEFORE=120
