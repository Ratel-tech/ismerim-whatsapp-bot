# Ismerim WhatsApp Bot - configuração
PORT=3081

# ---- IA (agente) ----
# Provedor: deepseek | openai | codex | gemini
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
# (legado - usa como fallback se AI_API_KEY/AI_MODEL estiverem vazios)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Transcrição de áudio (STT) - o bot ouve notas de voz do WhatsApp ----
# Endpoint OpenAI-compatível (/audio/transcriptions). Ex.:
#   OpenAI:     URL=https://api.openai.com/v1/audio/transcriptions  MODEL=whisper-1
#   Groq:       URL=https://api.groq.com/openai/v1/audio/transcriptions  MODEL=whisper-large-v3
# Se TRANSCRIBE_API_KEY ficar vazio ou TRANSCRIBE_ENABLED=false, o bot avisa que não ouve áudios.
TRANSCRIBE_ENABLED=true
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1

# Número que receberá a notificação de novos agendamentos (ex: 5511999999999)
ADMIN_PHONE=
# Opcional: senha do painel local (http://localhost:3081). Se vazio, painel sem senha.
PANEL_TOKEN=
